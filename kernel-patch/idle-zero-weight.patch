+/*
+ * Zero service must not accumulate an unbounded virtual-time debt. Advance
+ * waiting idle entities with normal virtual time, preserving their relative
+ * deadline. Besides avoiding catch-up bursts when the feature is disabled,
+ * this keeps the ordinary aggregate arithmetic bounded during starvation.
+ */
+static void rebase_idle_entities(struct cfs_rq *cfs_rq, u64 vruntime)
+{
+	struct sched_entity *curr = cfs_rq->curr, *se;
+	struct rb_node *node, *next;
+	s64 delta;
+
+	if (curr && curr->on_rq && entity_has_only_idle_work(curr)) {
+		delta = (s64)(vruntime - curr->vruntime);
+		if (delta > 0) {
+			curr->vruntime += delta;
+			curr->deadline += delta;
+		}
+	}
+
+	for (node = rb_first_cached(&cfs_rq->tasks_timeline); node; node = next) {
+		next = rb_next(node);
+		se = __node_2_se(node);
+		if (!entity_has_only_idle_work(se))
+			continue;
+		delta = (s64)(vruntime - se->vruntime);
+		if (delta <= 0)
+			continue;
+		__dequeue_entity(cfs_rq, se);
+		se->vruntime += delta;
+		se->deadline += delta;
+		__enqueue_entity(cfs_rq, se);
+		/*
+		 * Deadlines only move forward. A reinserted node encountered
+		 * again is already at @vruntime, so traversal still terminates.
+		 */
+	}
+}
